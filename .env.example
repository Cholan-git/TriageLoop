# Copy to .env and adjust. Never commit a real .env file.
# development | production (production requires TRIAGELOOP_SECRET_KEY and HTTPS)
TRIAGELOOP_ENV=development
# Long random string, e.g. output of: python -c "import secrets; print(secrets.token_hex(32))"
# Leave empty in development to use an auto-generated key stored in instance/secret_key.
TRIAGELOOP_SECRET_KEY=
TRIAGELOOP_DATABASE=instance/triageloop.db
TRIAGELOOP_TIMEZONE=Asia/Kolkata
TRIAGELOOP_HOST=127.0.0.1
TRIAGELOOP_PORT=5000
